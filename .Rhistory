filter(!is.na(plec)) %>%
count(plec) %>%
mutate(procent = 100 * n / sum(n))
cbos %>%
filter(!is.na(miejscowosc)) %>%
count(miejscowosc) %>%
mutate(procent = 100 * n / sum(n))
sum(!is.na(cbos$plec))
