dane %>%
mutate(
Release.Date = as.Date(Release.Date, format = "%d/%m/%Y"),
Netflix.Release.Date = as.Date(Netflix.Release.Date, format = "%d/%m/%Y")
) %>%
filter(Release.Year %in% c(2019, 2020)) %>%
mutate(Days = as.numeric(Netflix.Release.Date - Release.Date)) %>%
summarise(Mean.Days = mean(Days, na.rm = TRUE))
