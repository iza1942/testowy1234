wynik1 <- cbos %>%
filter(kierunek %in% c("W dobrym", "W złym")) %>%
count(kierunek) %>%
mutate(procent = 100 * n / sum(n)) %>%
filter(kierunek == "W dobrym")
View(wynik1)
summarise(wynik1)
summarise(procent = sum(procent))
wynik1
wynik2 <- cbos %>%
count(kierunek) %>%
mutate(procent = 100 * n / sum(n)) %>%
filter(kierunek == "W dobrym")
wynik2
View(wynik2)
wynik1$procent - wynik2$procent
wynik1$procent
wynik2$procent
